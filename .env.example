# Copy to .env and fill in. Never commit .env.
#
# Keep comments on their own lines: python-dotenv reads `NAME=   # note` as the
# value "# note". Leave an optional variable commented out rather than empty -
# an empty KW_TZ or DATABASE_URL stops the bot at startup.
# Details: docs/DEPLOYMENT.md

# Required. The bot's token from @BotFather.
BOT_TOKEN=

# Required. Your numeric Telegram user id (ask @userinfobot); the only account
# allowed to use /notify.
ADMIN_ID=

# Optional. Google Gemini API key for the chat assistant; without it the
# assistant says it is not configured and everything else still works.
#GEMINI_API_KEY=

# Optional. Directory holding bot_users.db and encryption_key.key. Must already
# exist and be writable. Defaults to the working directory; on Railway, the
# volume's mount path.
#DATA_DIR=/data

# Optional. Fernet key for the stored passwords; when unset, the key file in
# DATA_DIR is used. Required on hosts with an ephemeral filesystem. Never
# replace it on a database that already has users. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#ENCRYPTION_KEY=

# Optional. Full SQLAlchemy URL, overriding the SQLite file in DATA_DIR. Leave
# unset in production.
#DATABASE_URL=sqlite+aiosqlite:////data/bot_users.db

# Optional. Seconds between notification cycles (default 1800).
#NOTIFICATION_CHECK_INTERVAL=1800

# Optional. Timezone the bot treats as local time (default Asia/Seoul). KLAS
# dates are Korean local time, so leave this unset.
#KW_TZ=Asia/Seoul

# Not for you to set: RAILWAY_ENVIRONMENT is provided by Railway itself. When
# it is present and stdout is not a terminal, the bot logs JSON to stdout and
# skips logs/kwbot.log.
