[Unit]
Description=Kwangwoon University Todo Bot Daemon
After=network.target

# Edit User and the two paths below before installing this file.
[Service]
User=<your-user>
Group=<your-group>
WorkingDirectory=/path/to/klas_notification_bot
ExecStart=/path/to/klas_notification_bot/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=300

[Install]
WantedBy=multi-user.target
